#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON="${PYTHON:-python3}"
UPSTREAM="$ROOT/upstream/mattpocock-skills"

usage() {
  cat <<'EOF'
Usage: ./agent-skills <command> [options]

Commands:
  install [options]
      Install or reconcile the environment declared by this checkout.

  update
      Fast-forward agent-skills, sync its pinned Matt submodule,
      reconcile installed links, and verify. Never commit or push.

  verify
      Read-only check of the pinned upstream, installer tests, and links.

  help
      Show this help.

Typical use:
  ./agent-skills install   # first setup / repair
  ./agent-skills update    # normal maintenance
  ./agent-skills verify    # read-only health check
EOF
}

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "Missing required command: $1" >&2
    exit 1
  fi
}

ensure_upstream() {
  if [[ ! -e "$UPSTREAM/.git" ]]; then
    echo "Initializing pinned upstream..."
    git -C "$ROOT" submodule update --init --recursive
  fi
}

verify_upstream_pin() {
  local pinned current
  if [[ ! -e "$UPSTREAM/.git" ]]; then
    echo "Pinned Matt upstream is not initialized; run './agent-skills install'." >&2
    return 1
  fi

  pinned="$(git -C "$ROOT" ls-tree HEAD -- upstream/mattpocock-skills | awk '$2 == "commit" {print $3}')"
  if [[ -z "$pinned" ]]; then
    echo "Cannot find the Matt submodule pin in HEAD." >&2
    return 1
  fi
  current="$(git -C "$UPSTREAM" rev-parse HEAD)"
  if [[ "$current" != "$pinned" ]]; then
    echo "Matt upstream checkout ($current) differs from the repository pin ($pinned)." >&2
    echo "Review local submodule changes before restoring the pinned revision." >&2
    return 1
  fi
  echo "Matt upstream matches the pinned revision: $pinned"
}

run_tests() {
  echo
  echo "==> Running tests"
  PYTHONDONTWRITEBYTECODE=1 "$PYTHON" -m unittest discover -s "$ROOT/tests" -v
}

verify_environment() {
  echo
  echo "==> Verifying installed environment"
  PYTHONDONTWRITEBYTECODE=1 "$PYTHON" "$ROOT/install.py" --verify
}

has_arg() {
  local needle="$1"
  shift
  local arg
  for arg in "$@"; do
    if [[ "$arg" == "$needle" ]]; then
      return 0
    fi
  done
  return 1
}

require_clean_update_tree() {
  if [[ -n "$(git -C "$ROOT" status --porcelain --untracked-files=no)" ]]; then
    cat >&2 <<'EOF'
Repository has tracked local changes (possibly a changed submodule pin).
Review, commit, or safely restore them before './agent-skills update'.
EOF
    exit 1
  fi
}

reconcile_environment() {
  verify_upstream_pin
  run_tests
  echo
  echo "==> Reconciling installed environment"
  "$PYTHON" "$ROOT/install.py"
  verify_environment
}

command="${1:-help}"
if [[ $# -gt 0 ]]; then
  shift
fi

require_command git
require_command "$PYTHON"

case "$command" in
  install)
    ensure_upstream
    verify_upstream_pin
    run_tests
    echo
    echo "==> Installing environment"
    "$PYTHON" "$ROOT/install.py" "$@"
    if ! has_arg "--dry-run" "$@"; then
      verify_environment
      echo
      echo "Environment installed and healthy."
    fi
    ;;

  update)
    if [[ $# -ne 0 ]]; then
      echo "'update' does not accept additional arguments." >&2
      usage >&2
      exit 2
    fi

    require_clean_update_tree
    echo "==> Updating agent-skills"
    git -C "$ROOT" pull --ff-only
    git -C "$ROOT" submodule update --init --recursive
    reconcile_environment
    echo
    echo "Update complete. Matt upstream remains at the repository pin."
    ;;

  verify)
    if [[ $# -ne 0 ]]; then
      echo "'verify' does not accept additional arguments." >&2
      usage >&2
      exit 2
    fi
    verify_upstream_pin
    run_tests
    verify_environment
    echo
    echo "Environment healthy."
    ;;

  help|-h|--help)
    usage
    ;;

  *)
    echo "Unknown command: $command" >&2
    echo >&2
    usage >&2
    exit 2
    ;;
esac
