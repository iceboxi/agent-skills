#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON="${PYTHON:-python3}"
UPSTREAM="$ROOT/upstream/mattpocock-skills"

usage() {
  cat <<'EOF'
Usage: ./agent-skills <command> [options]

Commands:
  install [options]
      Install or reconcile the environment declared by this checkout.

  update
      Update agent-skills, check Matt upstream, optionally adopt a newer
      upstream revision, then reconcile and health-check the environment.

  doctor
      Run the test suite and verify the installed environment.

  help
      Show this help.

Typical use:
  ./agent-skills install   # first setup / repair
  ./agent-skills update    # normal maintenance
  ./agent-skills doctor    # when something looks wrong
EOF
}

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "Missing required command: $1" >&2
    exit 1
  fi
}

ensure_upstream() {
  if [[ ! -e "$UPSTREAM/.git" ]]; then
    echo "Initializing pinned upstream..."
    git -C "$ROOT" submodule update --init --recursive
  fi
}

run_tests() {
  echo
  echo "==> Running tests"
  "$PYTHON" -m unittest discover -s "$ROOT/tests" -v
}

verify_environment() {
  echo
  echo "==> Verifying installed environment"
  "$PYTHON" "$ROOT/install.py" --verify
}

run_doctor() {
  ensure_upstream
  run_tests
  verify_environment
  echo
  echo "Environment healthy."
}

has_arg() {
  local needle="$1"
  shift
  local arg
  for arg in "$@"; do
    if [[ "$arg" == "$needle" ]]; then
      return 0
    fi
  done
  return 1
}

require_clean_update_tree() {
  if [[ -n "$(git -C "$ROOT" status --porcelain --untracked-files=no)" ]]; then
    cat >&2 <<'EOF'
Repository has tracked local changes.
Commit or stash them before './agent-skills update'.
EOF
    exit 1
  fi
}

should_update_upstream() {
  if [[ ! -t 0 ]]; then
    echo "Matt upstream has an update, but stdin is not interactive; keeping the current pin."
    return 1
  fi

  local answer
  read -r -p "Matt upstream has an update. Apply, validate, commit, and push it? [y/N] " answer || true
  case "$answer" in
    y|Y|yes|YES|Yes) return 0 ;;
    *) return 1 ;;
  esac
}

reconcile_environment() {
  run_tests
  echo
  echo "==> Reconciling installed environment"
  "$PYTHON" "$ROOT/install.py"
  verify_environment
}

apply_upstream_update() {
  local previous
  previous="$(git -C "$UPSTREAM" rev-parse HEAD)"

  echo
  echo "==> Updating Matt upstream"
  if ! "$PYTHON" "$ROOT/update_upstream.py" --update; then
    return 1
  fi

  if ! run_tests || ! "$PYTHON" "$ROOT/install.py" || ! "$PYTHON" "$ROOT/install.py" --verify; then
    echo >&2
    echo "Upstream validation failed; restoring previous pin checkout: $previous" >&2
    git -C "$UPSTREAM" checkout --detach "$previous"
    "$PYTHON" "$ROOT/install.py" >/dev/null 2>&1 || true
    return 1
  fi

  git -C "$ROOT" add upstream/mattpocock-skills
  if git -C "$ROOT" diff --cached --quiet -- upstream/mattpocock-skills; then
    echo "Upstream checkout did not change."
    return 0
  fi

  git -C "$ROOT" commit -m "Update Matt skills upstream"

  if ! git -C "$ROOT" push; then
    cat >&2 <<'EOF'

Upstream was validated and committed locally, but push failed.
The installed environment is healthy; push the commit manually when ready.
EOF
    return 1
  fi

  echo
  echo "Matt upstream updated, validated, pinned, and pushed."
}

command="${1:-help}"
if [[ $# -gt 0 ]]; then
  shift
fi

require_command git
require_command "$PYTHON"

case "$command" in
  install)
    ensure_upstream
    run_tests
    echo
    echo "==> Installing environment"
    "$PYTHON" "$ROOT/install.py" "$@"
    if ! has_arg "--dry-run" "$@"; then
      verify_environment
      echo
      echo "Environment installed and healthy."
    fi
    ;;

  update)
    if [[ $# -ne 0 ]]; then
      echo "'update' does not accept additional arguments." >&2
      usage >&2
      exit 2
    fi

    require_clean_update_tree

    echo "==> Updating agent-skills"
    git -C "$ROOT" pull --ff-only
    git -C "$ROOT" submodule update --init --recursive
    ensure_upstream

    echo
    echo "==> Checking Matt upstream"
    "$PYTHON" "$ROOT/update_upstream.py"

    current="$(git -C "$UPSTREAM" rev-parse HEAD)"
    latest="$(git -C "$UPSTREAM" rev-parse origin/main)"

    if [[ "$current" != "$latest" ]] && should_update_upstream; then
      apply_upstream_update
    else
      reconcile_environment
      echo
      if [[ "$current" != "$latest" ]]; then
        echo "Update complete. Matt upstream remains pinned at $current."
      else
        echo "Everything is up to date and healthy."
      fi
    fi
    ;;

  doctor)
    if [[ $# -ne 0 ]]; then
      echo "'doctor' does not accept additional arguments." >&2
      usage >&2
      exit 2
    fi
    run_doctor
    ;;

  help|-h|--help)
    usage
    ;;

  *)
    echo "Unknown command: $command" >&2
    echo >&2
    usage >&2
    exit 2
    ;;
esac
